(footprint "MountingHole_M3_FabRef"
	(version 20260206)
	(generator "make_footprints.py")
	(layer "F.Cu")
	(descr "Mounting hole 3.2 mm M3, NPTH, reference on F.Fab")
	(attr board_only exclude_from_pos_files exclude_from_bom)
	(property "Reference" "REF**" (at 0 0 0) (layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15))))
	(property "Value" "M3" (at 0 2.5 0) (layer "F.Fab") (hide yes)
		(effects (font (size 1 1) (thickness 0.15))))
	(fp_circle (center 0 0) (end 3 0) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
	(pad "" np_thru_hole circle (at 0 0) (size 3.2 3.2) (drill 3.2) (layers "*.Cu" "*.Mask"))
)
