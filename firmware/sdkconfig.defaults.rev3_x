# Взято дословно из примера 04_wifistation репозитория платы Waveshare.
# Профиль под ревизию кристалла 3.x. Какая ревизия у нас - покажет
# проверочная программа при первом запуске.
# ESP32-P4 rev3.x default profile.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
CONFIG_ESP32P4_REV_MIN_300=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_SPEED=250
